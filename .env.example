# Telegram Bot configuration
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Web search API
TAVILY_API_KEY=your_tavily_key_here

# Local Ollama services (two specialized models replacing Groq and DeepSeek)
# groq-ollama  -> boolean triage     (model: ollama-groq)
# deepseek-ollama -> CV match analysis (model: ollama-deepseek)
GROQ_OLLAMA_URL=http://groq-ollama:11434
DEEPSEEK_OLLAMA_URL=http://deepseek-ollama:11434
TRIAGE_MODEL=ollama-groq
ANALYSIS_MODEL=ollama-deepseek

# Base model pulled by the ollama containers at build time
OLLAMA_MODEL=qwen2.5:3b-instruct
